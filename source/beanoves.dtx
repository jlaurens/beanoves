\BNVS_new:cpn { gset_IPKV:NNw } #1 #2 #3 #4 {
  \seq_gclear_new:N #1
  \cs_new:Npn #2 ##1 ##2 {
    \seq_if_in:NnF #1 { ##1 } {
      \seq_gput_right:Nn #1 { ##1 }
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
      \BNVS_DEBUG_seq_gsort:N #1
%</!final>
