    \cs_new:Npn #1 ##1 {
      \seq_if_in:NnF #2 { ##1 } {
        \seq_gput_right:Nn #2 { ##1 }
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
        \BNVS_DEBUG_seq_gsort:N #2
%</!final>
% \end{BNVS.gobble}
