% \begin{function}{
%   \__bnvs_map_AZ:nw,
% }
% \begin{syntax}
% \KWNlatex*{\__bnvs_map_AZ:nw} \KWNlatex{{|\KWNmeta{:nnn}|}}^^A
% \KWNmeta{i} : \KWNmeta{j} : \KWNmeta{k} \KWNlatex{\s_stop} ^^A
% \end{syntax}
% Used to extract ranges in colon denotation.
% \KWNmeta{:nnn} is called with integer arguments
% \KWNmeta{i}, \KWNmeta{j} and \KWNmeta{k}.
% \KWNmeta{i} is a standalone value,
% \KWNmeta{j} `-` \KWNmeta{k} is a range, \KWNmeta{k} only may be empty,
% \KWNmeta{j} $<$ \KWNmeta{k} when it makes sense.
% \end{function}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\BNVS_new:cpn { map_AZ:nw } #1 #2 : #3 : #4 \s_stop {
  \cs_set:Npn \BNVS_map_AZ_nw:w ##1 ##2 ##3 { #1 }
  \tl_if_blank:nTF { #4 } {
    \BNVS_map_AZ_nw:w { #2 } { } { }
  } {
    \tl_if_empty:nTF { #3 } {
      \BNVS_map_AZ_nw:w { } { #2 } { }
    } {
      \int_compare:nNnTF { 0#2 } > { #3 } {
        \BNVS_map_AZ_nw:w { } { } { }
      } {
        \int_compare:nNnTF { 0#2 } = { #3 } {
          \BNVS_map_AZ_nw:w { #2 } { } { }
        } {
          \BNVS_map_AZ_nw:w { } { #2 } { #3 }
        }
      }
    }
  }
}
%    \end{macrocode}
