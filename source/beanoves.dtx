\cs_new:Npn \BNVS_to_AZ:n #1 {
  \BNVS_to_AZL:n { #1 }
  \quark_if_nil:VTF \l__bnvs_Z_tl {
    \tl_if_empty:NT \l__bnvs_A_tl {
