\cs_new:Npn \BNVS_to_AZL:n #1 {
  \__bnvs_tl_clear:c L
  \tl_if_empty:nTF { #1 } {
    \__bnvs_tl_set:cn A 1
    \__bnvs_tl_set:cn Z { \q_nil }
  } {
    \tl_set:Nn \l__bnvs_A_tl { #1 }
    \regex_replace_once:nnNTF { ( [^:] *) : ( .* ) } {
