% \begin{syntax}
% "\BNVS_head_V:c"  \KWNmarg{resolved var}
% "\BNVS_head_V:nc" \KWNmarg{resolved} \KWNmarg{var}
% "\BNVS_head_N:c"  \KWNmarg{resolved var}
