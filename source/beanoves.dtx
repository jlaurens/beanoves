% \item \KWNlatex*{I!S.A} $\to$ \KWNlatex*{\ISR:w{I}{S}{\PR:w{A}{}}}
% \item \KWNlatex*{I!S.A.B} $\to$ \KWNlatex*{\ISR:w{I}{S}{\PR:w{A}{\PR:w{B}{}}}}
% \item \KWNlatex*{I!S.+-123} $\to$ \KWNlatex*{\ISR:w{I}{S}{\NR:w{-123}{}}}
% \item \KWNlatex*{I!S[1+2]}  $\to$ \KWNlatex*{\ISR:w{I}{S}{\nR:w{1+2}{}}}
% \end{itemize}
% and not standalone (calls and assignments)
% \begin{itemize}
% \item \KWNlatex*{I!S(|\KWNmeta{...}|)} $\to$ \KWNlatex*{\ISR:wn{I}{S}{}{|\KWNmeta{...}|}}
% \item \KWNlatex*{I!S?=|\KWNmeta{Rhs}|} $\to$ \KWNlatex*{\ISR:wnn{I}{S}{}{?}{|\KWNmeta{Rhs}|}}
