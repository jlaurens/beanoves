% ^^A
% \begin{function}{
%   \__bnvs_gunset:nnn,
%   \__bnvs_gunset:vvn,
% }
% \begin{syntax}
% \KWNlatex*{\__bnvs_gunset:nnn} \KWNmarg{id} \KWNmarg{path} \KWNmarg{key}
% \end{syntax}
% Removes the specifications for the
% \KWNmeta{id}\KWNlatex{!}\KWNmeta{path}\KWNlatex{/}\KWNmeta{key}
% combination.
% \end{function}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\seq_new:N \l__bnvs_I_seq
\BNVS_new:cpn { seq_gremove_once:Nn } #1 #2 {
  \seq_clear:N \l__bnvs_I_seq
  \cs_set:Npn \BNVS_seq_gremove_Nn:n ##1 {
    \tl_if_eq:nnTF { ##1 } { #2 } {
      \cs_set:Npn \BNVS_seq_gremove_Nn:n ####1 {
        \seq_put_right:Nn \l__bnvs_I_seq { ####1 }
      }
    } {
      \seq_put_right:Nn \l__bnvs_I_seq { ##1 }
    }
  }
  \seq_map_function:NN #1 \BNVS_seq_gremove_Nn:n
  \seq_gset_eq:NN #1 \l__bnvs_I_seq
}
%    \end{macrocode}
% \end{BNVS.macrocode}
% \begin{BNVS.macrocode}
% \begin{BNVS.gobble}
% \#1 -> { \__bnvs_g_I:w { #1 } }
% and I, P
