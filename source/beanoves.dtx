% \begin{BNVS.macrocode}
%    \begin{macrocode}
\BNVS_new:cpn { prepare:nnc } #1 #2 #3 {
  \cs_set:Npn \BNVS:N ##1 {
    \cs_set:Npn \BNVS_loop: {
      \exp_args:Nc \regex_replace_all:NnNT { c__bnvs_#1_n_regex } {
        \c { BNVS_#1:n } \cB \{ \1 \cE \}
      } ##1 {
        \BNVS_loop:
      }
    }
    \BNVS_loop:
    \exp_args:Nc \regex_match:NVT { c__bnvs_#1_regex } ##1 {
      \BNVS_error:n { #2 }
    }
  }
  \BNVS_tl_use:Nc \BNVS:N { #3 }
}
