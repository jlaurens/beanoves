% ^^A
% \subsubsection{Storage}
% ^^A
% There are different policies to store the intermediate results of a scanning operation.
% One possibility is to feed a global variable as scanning occurs.
% As you cannot use unbalanced braces in function arguments,
% we can use other characters than usual ``\textbackslash'', ``\{'' and ``\}''
% before we rescan the final result with an appropriate catcode regime.
% Another possibility is to heavily use \TeX\ groups to store intermediate results
% in local variables and only consider properly balanced material.
% At the end of the group, the scanned material must be forwarded to the group owner.
% The latter is used here.
%
% There is also a special situation for raw material that is stored separately
% and exported at once before other material is exported or when a scan group
% ends.
% ^^A
% \begin{function} {
%   \BNVS_xprt_clear:,
%   \BNVS_xprt:n,
%   \BNVS_scan_xprt_black:n,
% }
% \begin{syntax}
% \KWNlatex*{\BNVS_xprt_clear:}
% \KWNlatex*{\BNVS_xprt:n} \KWNlatex*{{|\KWNmeta{material}|}}
% \KWNlatex*{\BNVS_scan_xprt_black:n} \KWNlatex*{{|\KWNmeta{material}|}}
% \end{syntax}
% \end{function}
% \KWNlatex*{\BNVS_xprt_clear:} resets the scan storage,
% called when starting a new \TeX\ group dedicated to scanning.
% \KWNlatex*{\BNVS_xprt:n} is a utility function to store its argument
% in the |xprted| variable.
% Automatically set by \KWNlatex{\BNVS_begin_scan:...} functions.
% Used by \KWNlatex{\BNVS_end_scan:}.
% The default implementation just raises.
% \KWNlatex*{\BNVS_xprt_grp:n}
% feeds the scan storage with \KWNmeta{material},
% enclosed betwenn one pair of curly braces.
% \KWNlatex*{\BNVS_scan_xprt_black:n} is called just before exporting.
% The argument is enclosed inside \KWNlatex*{\exp_not:n{|\KWNmeta{...}|}}.
% The default implementation just expands to its argument as is.
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\cs_new:Npn \BNVS_xprt_clear: {
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
  \__bnvs_tl_if_empty:cF { stored } {
    \BNVS_error:x {
      stored~not~empty:~\BNVS_tl_use:Nv \exp_not:n { stored }
    }
    \__bnvs_tl_clear:c { stored }
  }
%</!final>
% \end{BNVS.gobble}
%    \begin{macrocode}
  \__bnvs_tl_clear:c { xprted }
}
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
\hook_gput_code:nnn { env/BNVS.test/begin } { bnvs } { \BNVS_xprt_clear: }
%</!final>
% \end{BNVS.gobble}
% \end{BNVS.macrocode}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\cs_new:Npn \BNVS_xprt:n #1 {
  \BNVS_xprt_stored:
  \__bnvs_tl_put_right:cn { xprted } { #1 }
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
  \BNVS_coverage:n { xprt:n { #1 } }
  \__bnvs_tl_if_empty:cTF { xprted } {
    \BNVS_DEBUG_log:nn * { <empty> }
  } {
    \BNVS_tl_use:nv { \BNVS_DEBUG_log:nn *  } { xprted }
  }
%</!final>
% \end{BNVS.gobble}
%    \begin{macrocode}
}
%    \end{macrocode}
% \end{BNVS.macrocode}
% ^^A
% \begin{function} {
%   \BNVS_xprt_grp:n,
%   \BNVS_xprt_use:n,
% }
% \begin{syntax}
% \KWNlatex*{\BNVS_xprt_grp:n} \KWNlatex*{{|\KWNmeta{scanned}|}}
% \KWNlatex*{\BNVS_xprt_use:n} \KWNlatex{{|\KWNmeta{code:n}|}}
% \end{syntax}
% \KWNlatex*{\BNVS_xprt_grp:n} exports its argument between curly braces.
% \KWNlatex*{\BNVS_xprt_use:n} puts back to the input stream
% the exported material so far,
% enclosed in one pair of braces after the instructions \KWNmeta{code:n}.
% \end{function}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\cs_new:Npn \BNVS_xprt_use:n #1 {
  \BNVS_xprt_stored:
  \BNVS_tl_use:nv { #1 } { xprted }
}
%    \end{macrocode}
% \end{BNVS.macrocode}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\cs_new:Npn \BNVS_xprt_grp:n #1 {
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
  \BNVS_coverage:n { xprt_crl:n }
  \exp_args:Ne \BNVS_coverage:n { \tl_to_str:n { #1 } }
%</!final>
% \end{BNVS.gobble}
%    \begin{macrocode}
  \BNVS_xprt:n { { #1 } }
}
%    \end{macrocode}
