% }
% \begin{syntax}
% \KWNlatex*{\BNVS_to_AZ:n} \KWNlatex{{|\KWNmeta{range}|}}
% \end{syntax}
% Split \KWNmeta{range} into "A" and "Z" variables.
% Range components are delimited by \KWNlatex{\BNVS_colon:} or \KWNlatex{\BNVS_two_colons:}.
% The "A" variable contains a positive integer,
% which is the start of the range.
% The "Z" variable contains contains \KWNlatex{\q_nil} for a
% one length range, a nonnegative integer, or nothing
% for an infinite range.
% Auxiliary functions are \KWNlatex{\BNVS_to_AZL:n},
% \KWNlatex{\BNVS_to_AZL:nnn} and \KWNlatex{\BNVS_to_ZL:nnnn}.
% \end{function}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\cs_new:Npn \BNVS_to_ZL:nnnn #1 #2 #3 #4 {
  \tl_if_empty:nF { #3 } {
    \BNVS_error:x {
      Bad~colon~range~syntax~"\tl_to_str:n { #4 ( #3 ) }".
    }
  }
  \__bnvs_tl_set:cn Z { #1 }
  \__bnvs_tl_set:cn L { #2 }
}
%    \end{macrocode}
% \begin{BNVS.test}{:N=\BNVS_to_ZL:nnnn, eringo}
