    }
  } {
    \__bnvs_tl_if_empty:cTF A {
      \__bnvs_tl_if_empty:cTF Z {
        \__bnvs_tl_set:cn A 1
        \__bnvs_tl_if_empty:cF L {
          \__bnvs_tl_set:ce Z { \int_max:nn 0 { \l__bnvs_L_tl } }
        }
      } {
        \__bnvs_tl_if_empty:cTF L {
          \__bnvs_tl_set:cn A 1
        } {
          \__bnvs_tl_set:ce A { \int_max:nn 1 {
            \l__bnvs_Z_tl - \l__bnvs_L_tl + 1
          } }
        }
        \__bnvs_tl_set:ce Z { \int_max:nn 0 { \l__bnvs_Z_tl } }
      }
    } {
      \__bnvs_tl_if_empty:cTF Z {
        \__bnvs_tl_if_empty:cF L {
          \__bnvs_tl_set:ce Z { \int_max:nn 0 {
            \l__bnvs_A_tl + \l__bnvs_L_tl - 1
          } }
        }
      } {
        \__bnvs_tl_set:ce Z { \int_max:nn 0 { \l__bnvs_Z_tl } }
      }
    }
  }
}
