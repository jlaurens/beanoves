% ^^A
% \subsubsection{Base grammar}
% ^^A
% Hereafter is a pragmatic grammar used for parsing, 
% not all the expressions covered do have a real meaning.
% The characters all have category other.
% We start with basic entities.
% \input{\jobname-grammar-base.tex}
% \begin{variable}{\c__bnvs_N_regex}
% Signed integer.
% \end{variable}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\regex_const:Nn \c__bnvs_N_regex {
  [-+]* \d+
