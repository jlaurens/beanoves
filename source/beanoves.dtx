% \end{syntax}
% Resolve the \KWNlatex{|\KWNmeta{id}|!|\KWNmeta{path}|/|\KWNmeta{key}|}
% reference and set \KWNmeta{var} to the result.
% Use the default \meta{id} mechanism.
% We start with two utilities used to ensure that definitions are not
% circular because \KWNlatex{\__bnvs_resolve:nnnc} calls
% \KWNlatex{\__bnvs_resolve_query:nc} which may in turn call
% \KWNlatex{\__bnvs_resolve:nnnc}.
% \textcolor{red}{See \KWNlatex{\__bnvs_will_gset:...}.}
% \end{function}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\BNVS_new:cpn { no_circular:nnnn } #1 #2 #3 #4 {
  \__bnvs_gset:nnnn  { #1 } { #2 } { ?#3 } {}
  #4
  \__bnvs_gunset:nnn { #1 } { #2 } { ?#3 }
}
%    \end{macrocode}
% \end{BNVS.macrocode}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\BNVS_new:cpn { is_circular:nnnTF } #1 #2 #3 #4 {
  \__bnvs_is_gset:nnnTF  { #1 } { #2 } { ?#3 } {
    \__bnvs_is_gset:nnnF { #1 } { #2 } { !#3 } {
      \__bnvs_gset:nnnn  { #1 } { #2 } { !#3 } { }
      \BNVS_warning:n { Circular~definition:~#1!#2/#3 (Once~per~frame) }
    }
    #4
  }
}
%    \end{macrocode}
