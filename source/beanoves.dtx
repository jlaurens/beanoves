% ^^A
% \subsection{Resolution}
% Resolution means to transform \KWNlatex{?(|\KWNmeta{queries}|)} into
% static \pkg{beamer} range expressions.
% This is a quite complex task because we allow at the same time algebraic expressions
% and \pkg{beamer} range expressions which seem like differences
% but are not algebraic expressions by themselves.
% Names generally contain ``resolve''.
%
% Overall sketch:
% \KWNlatex{\__bnvs_resolve:nc} is the top level resolution function.
% It is called by  \KWNlatex{\__bnvs@frame}, \KWNlatex{\__bnvs@masterdecode}
% or \KWNlatex{\BeanovesResolve} and for the resolution of embedded subqueries
% \KWNlatex{?(|\KWNmeta{queries}|)} or \KWNlatex{!:(|\KWNmeta{queries}|)}
% as well, it calls \KWNlatex{\__bnvs_resolve:nc}, which in turns calls
% \KWNlatex{\__bnvs_resolve_queries:nc}.
% The main functions used for resolution are
% \begin{itemize}[label=\raisebox{-0.2ex}{\footnotesize\emoji{footprints}}]
% \item \KWNlatex{\__bnvs_resolve_prepare:nc},
% called first, on return the prepared material consists of
% \begin{itemize}
% \item \KWNlatex{\BNVS_raw_to_stop:w|\KWNmeta{raw text}|\s_stop}
% for everything not special,
% \item \KWNlatex{\BNVS_paren:n{|\KWNmeta{...}|}}
% for material between rounded brackets,
% \item \KWNlatex{\BNVS_bIKDPN:w}^^A
% \KWNlatex{{|\KWNmeta{b}|}}^^A
% \KWNlatex{{|\KWNmeta{I}|}}^^A
% \KWNlatex{{|\KWNmeta{K}|}}^^A
% \KWNlatex{{|\KWNmeta{D}|}}^^A
% \KWNlatex{{|\KWNmeta{P}|}}^^A
% \KWNlatex{{|\KWNmeta{N}|}},
% for specifications
% \item \KWNlatex{\BNVS_V:n{|\KWNmeta{...}|}}
% for a value,
% \item \KWNlatex{\BNVS_R:n{|\KWNmeta{...}|}}
%   for a comma sepatated list of ranges.
% \item \KWNlatex{\BNVS_plus:n{|\KWNmeta{...}|}}
% for |++|,
% \item \KWNlatex{\BNVS_assign:n{|\KWNmeta{\vert+\vert?}|}}, for \KWNlatex{=}, \KWNlatex{+=} or \KWNlatex{?=}
% \item \KWNlatex{\::BNVS:} and \KWNlatex{\:BNVS:} are range delimiters
% \end{itemize}
% \item \KWNlatex{\__bnvs_resolve_subqueries:c},
% after resolution of subqueries the material consists of
% \begin{itemize}
% \item \KWNlatex{\BNVS_raw:n{|\KWNmeta{raw text}|}}
% for everything not special,
% \item \KWNlatex{\BNVS_bITN:w}^^A
% \KWNlatex{{|\KWNmeta{b}|}}^^A
% \KWNlatex{{|\KWNmeta{I}|}}^^A
% \KWNlatex{{|\KWNmeta{T}|}}^^A
% \KWNlatex{{|\KWNmeta{N}|}},
% for specifications
% \item \KWNlatex{\BNVS_plus:n{|\KWNmeta{number of \texttt{++}}|}},
% \item \KWNlatex{\BNVS_V:n{|\KWNmeta{...}|}}
% for a single static resolved value,
% \item \KWNlatex{\BNVS_R:n{|\KWNmeta{...}|}}
%   for a list of static resolved
%   \KWNmeta{A}, \KWNmeta{A}: and \KWNmeta{A}:\KWNmeta{Z} ranges,
%   \KWNmeta{A} being positive and
%   \KWNmeta{Z} being nonnegative,
% \item \KWNlatex{\BNVS_assign:n{|\KWNmeta{\vert+\vert?}|}}, for \KWNlatex{=}, \KWNlatex{+=} or \KWNlatex{?=},
% \item \KWNlatex{\::BNVS:} and \KWNlatex{\:BNVS:}, range delimiters.
% \end{itemize}
% \item \KWNlatex{\__bnvs_resolve_assign:nc}
% \item \KWNlatex{\__bnvs_resolve_rhs:c}
% \item \KWNlatex{\__bnvs_assign:Nwnnc}
% \end{itemize}
% The top level queries are a comma separated list of individual queries
% as augmented range specifications.
% Each individual query is temporarily stored in its own variable, then commands are inserted
% as markup. This variable is then executed to feed the top level resolution variable.
%
% The augmentations in individual queries can take different forms.
% At the top level we have only \KWNlatex{?(|\KWNmeta{queries}|)} or \KWNlatex{!:(|\KWNmeta{queries}|)} and inside we may have
% \begin{itemize}
% \item embedded \KWNlatex{?(|\KWNmeta{queries}|)} or \KWNlatex{!:(|\KWNmeta{queries}|)},
% \item colon delimited ranges,
% \item various assignments (standard, with increment and as provider),
% \item references with possible square brackets specification,
% \item pre and post increment.
% \end{itemize}
% ^^A
% \begin{variable}{\c__bnvs_g_IKDSPN_regex}
% Used by \KWNlatex{\__bnvs_resolve_prepare:nc}.
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\regex_const:Nn \c__bnvs_bIKDPN_regex {
  ( (?: \+\+ )* )
  (?: ( \ur{c__bnvs_S_regex} )? (!) | (\.) )?
  ( \ur{c__bnvs_S_regex} (?: \. \ur{c__bnvs_S_regex} )* )
  (?: \. ([-+\s]* \d+ ) )?
  \s*
}
%    \end{macrocode}
% \begin{BNVS.test}{banner=bIKDPN, eringo}
% \Test_regex:nnnn
%   { bIKDPN }
%   { I!A }
%   { I!A, {}, I, !, {}, {A}, {} }
%   { 1 }
% \Test_regex:nnnn
%   { bIKDPN }
%   {  !A }
%   {  !A, {}, {}, !, {}, {A}, {} }
%   { 2 }
% \Test_regex:nnnn
%   { bIKDPN }
%   {  .A }
%   {  .A, {}, {}, {}, {.}, {A}, {} }
%   { 3 }
% \Test_regex:nnnn
%   { bIKDPN }
%   {  .A.B }
%   {  .A.B, {}, {}, {}, {.}, {A.B}, {} }
%   { 4 }
% \Test_regex:nnnn
%   { bIKDPN }
%   {   A.B }
%   {   A.B, {}, {}, {}, {}, {A.B}, {} }
%   { 5 }
% \Test_regex:nnnn
%   { bIKDPN }
%   {   A.-421 }
%   {   A.-421, {}, {}, {}, {}, {A}, {-421} }
%   { 6 }
% \Test_regex:nnnn
%   { bIKDPN }
%   {   ++A }
%   {   ++A, ++, {}, {}, {}, {A}, {} }
%   { 7 }
% \end{BNVS.test}
% \end{BNVS.macrocode}
% \end{variable}
