% \end{syntax}
% Restrict in place \KWNmeta{resolved var} to its leading value or
% put the leading value of \KWNmeta{resolved} into \KWNmeta{var}.
% In the `|N|' variant, negative values are mapped to `|0|'.
% In the ``|:n.|'' variant, the variable is first fed with \KWNmeta{resolved}.
% \end{function}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
