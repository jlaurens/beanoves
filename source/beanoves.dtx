    \cs_set:Npn \BNVS:n ####1 {
      \__bnvs_tl_put_right:cn { #3 } { \BNVS:n { ####1 } }
    }
    \cs_set:Npn \BNVS:nn ####1 ####2 {
      \__bnvs_tl_put_right:cn { #3 } { \BNVS:nn { ####1 } { ####2 } }
    }
  }
