%    \begin{macrocode}
\BNVS_new:cpn { gunset_IP:Nw } #1 #2 #3 {
  \__bnvs_seq_gremove_once:Nn #1 { #3 }
  \seq_if_empty:NT #1 {
    \__bnvs_seq_gremove_once:Nn \g__bnvs_I_seq { #2 }
    \cs_undefine:c { __bnvs_gset@#2:nnn}
  }
}
%    \end{macrocode}
% \end{BNVS.macrocode}
% \begin{BNVS.macrocode}
