% and I, P, K
% \end{BNVS.gobble}
%    \begin{macrocode}
\BNVS_new:cpn { gunset:NNnnn } #1 #2 #3 #4 #5 {
  \tl_if_exist:NT #1 {
    \cs_undefine:N #1
    \__bnvs_seq_gremove_once:Nn #2 { #5 }
    \seq_if_empty:NT #2 {
      \exp_args:Nc \__bnvs_gunset_IP:Nw { \__bnvs_g_I:w { #3 } } { #3 } { #4 }
      \cs_undefine:c { __bnvs_gset@#3!#4:nn}
