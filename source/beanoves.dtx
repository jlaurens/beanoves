% Used by \KWNlatex[to:c={prepare:nnc}]{\__bnvs_prepare_crl:nc},
% \KWNlatex[to:c={prepare:nnc}]{\__bnvs_prepare_sqr:nc} and
% \KWNlatex[to:c={prepare:nnc}]{\__bnvs_prepare_rnd:nc}.
% Implementation detail: local functions
% \KWNlatex{\BNVS:N} and \KWNlatex{\BNVS_loop:}.
