% \subsubsection{Data model}
% The whole data model is somehow similar to a hierarchical file system:
% the \KWNmeta{id} corresponds to the drive,
% the \KWNmeta{path} points to a directory,
% each directory may contain individual files.
% File named ``\KWNlatex{=}'' contains initial data
% whereas file named ``\KWNlatex{@}'' contains the static resolved data.
% The latter is initially undefined
% and becomes empty as soon as the initial data is defined or set.
% In order to allow index override,
% files respectively named ``\KWNmeta{N}'' and ``\KWNlatex{@}\KWNmeta{N}''
% are used similarly, \KWNmeta{N} denoting a normalized integer
% (no leading "0", no leading "+" sign).
% The dot (\KWNlatex{.}) is used to separate components of \KWNmeta{path}.
% ^^A
% \subsubsection{Low level IPK model functions}
% These are "gset" and "gunset" functions.
% Each "gset" function must be balanced by a "gunset" function
% to prevent ``memory leaks''.
%
% \begin{function}{
%   \__bnvs_gset:nnnn,
%   \__bnvs_gset:nnnv,
%   \__bnvs_gset:nnne,
%   \__bnvs_gset:vnnn,
%   \__bnvs_gset:nvnn,
%   \__bnvs_gset:nvnv,
%   \__bnvs_gset:vvnn,
%   \__bnvs_gset:vvnv,
% }
% \begin{syntax}
% \KWNlatex*{\__bnvs_gset:nnnn} \KWNlatex{{|\KWNmeta{id}|}} \KWNlatex{{|\KWNmeta{path}|}} \KWNlatex{{|\KWNmeta{key}|}} \KWNlatex{{|\KWNmeta{def}|}}
% \end{syntax}
% Manage the storage.
% Keep track of all the \KWNmeta{path}'s for a given \KWNmeta{id}
% and all the \KWNmeta{key}'s for a given \KWNmeta{id}\KWNlatex{!}\KWNmeta{path}
% combination.
% \end{function}
% Implementation details, next macros are defined lazily at the global level:
% \begin{itemize}
% \item \KWNlatex{\__bnvs_gset@|\KWNmeta{id}\PYG{k}{!}\KWNmeta{path}\PYG{k}{:nn}|}
% \KWNlatex{{|\KWNmeta{key}|}} \KWNlatex{{|\KWNmeta{def}|}}, 
% \item \KWNlatex{\__bnvs_gset@|\KWNmeta{id}\PYG{k}{:nnn}|}
% \KWNlatex{{|\KWNmeta{path}|}} \KWNlatex{{|\KWNmeta{key}|}} \KWNlatex{{|\KWNmeta{def}|}},
% \item \KWNlatex{\g__bnvs@|\KWNmeta{id}\PYG{k}{!\PYGZus{}paths\PYGZus{}tl}|},
% records all \KWNmeta{path} for \KWNmeta{id},
% \item \KWNlatex{\g__bnvs@|\KWNmeta{id}\PYG{k}{!}\KWNmeta{path}\PYG{k}{\PYGZus{}keys\PYGZus{}tl}|},
% records all \KWNmeta{key} for \KWNmeta{id}\KWNlatex{!}\KWNmeta{path},
% \item \KWNlatex{\g__bnvs@|\KWNmeta{id}\PYG{k}{!}\KWNmeta{path}\PYG{k}{\PYGZus{}keys\PYGZus{}tl}|},
% \item \KWNlatex{\g__bnvs@|\KWNmeta{id}\PYG{k}{!}\KWNmeta{path}\PYG{k}{/}\KWNmeta{key}\PYG{k}{\PYGZus{}tl}|},
% record the \KWNmeta{def} for the \KWNmeta{id}\KWNlatex{!}\KWNmeta{path}\KWNlatex{/}\KWNmeta{key} combination.
% \end{itemize}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\BNVS_new:cpn { gset:Nn } #1 {
  \tl_gclear_new:N #1
  \tl_gset:Nn #1
}
%    \end{macrocode}
% \begin{BNVS.gobble}
% \#1 -> { \__bnvs_g_IP:w { #3 } { #4 } }
% \#2 -> { gset@#3!#4:nn }
% and I P K V
% \end{BNVS.gobble}
%    \begin{macrocode}
\BNVS_new:cpn { gset_IPKV:NNw } #1 #2 #3 #4 {
  \seq_gclear_new:N #1
  \cs_new:Npn #2 ##1 ##2 {
    \seq_if_in:NnF #1 { ##1 } {
      \seq_gput_right:Nn #1 { ##1 }
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
      \BNVS_DEBUG_seq_gsort:N #1
%</!final>
% \end{BNVS.gobble}
%    \begin{macrocode}
    }
    \exp_args:Nc \__bnvs_gset:Nn {
      \__bnvs_g_IPK:w { #3 } { #4 } { ##1 }
    } { ##2 }
  }
  #2
}
%    \end{macrocode}
% \begin{BNVS.gobble}
% \#1 -> { __bnvs_gset@#3:nnn }
% \#2 -> { \__bnvs_g_I:w { #3 } }
% and I P K V
% \end{BNVS.gobble}
%    \begin{macrocode}
\BNVS_new:cpn { gset:NNnnnn } #1 #2 #3 #4 {
  \cs_if_exist_use:NF #1 {
