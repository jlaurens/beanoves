% \begin{function}{
%   \__bnvs_resolve_prepare:nc,
% }
% \begin{syntax}
% \KWNlatex*{\__bnvs_resolve_prepare:nc} \KWNlatex{{|\KWNmeta{queries}|}} \KWNlatex{{|\KWNmeta{var}|}}
% \end{syntax}
% Called by \KWNlatex*{\__bnvs_resolve_query:nc} and by 
% \KWNlatex*{\__bnvs_resolve_queries:nc}.
% Prepare the \KWNmeta{queries} into \KWNmeta{var}.
