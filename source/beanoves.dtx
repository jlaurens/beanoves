% }
% \begin{syntax}
% \KWNlatex*{\__bnvs_map:nnnn} \KWNlatex{{|\KWNmeta{tag}|}} \KWNlatex{{|\KWNmeta{S code:n}|}} \KWNlatex{{|\KWNmeta{R code:n}|}} \KWNlatex{{|\KWNmeta{no:n}|}}
% \end{syntax}
% If the \KWNmeta{tag} is not empty, execute \KWNmeta{S code:n} for
% the first component and then apply \KWNmeta{R code:n} to each next component.
% Otherwise, execute \KWNmeta{no:n} with the \KWNmeta{tag}.
% \end{function}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\BNVS_new:cpn { map_R:nnnn } #1 #2 #3 #4 {
  \tl_if_empty:nTF { #1 } {
    \cs_set:Npn \BNVS:n ##1 { #4 }
    \BNVS:n { #1 }
  } {
    \__bnvs_seq_set_split:cnn R { . } { #1 }
    \__bnvs_seq_pop_left:cc R R
    \cs_set:Npn \BNVS:n ##1 { #2 }
    \BNVS_tl_use:Nv \BNVS:n R
    \__bnvs_seq_map_inline:cn R { #3 }
  }
}
%    \end{macrocode}
