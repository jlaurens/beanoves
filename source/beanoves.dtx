% \subsubsection{Resolution scanner}
% ^^A
% The resolution scanner first converts the \KWNmeta{user query} into macros and text material.
% It is run within a \TeX\ group, local variables are used:
% \begin{description}
% \item[\texttt{A}:] for the state
% \item[\texttt{Q}:] for the output query
% \item[\texttt{B}:] for the previous character scanned
% \item[\texttt{C}:] for the cumulated storage of character scanned but the previous one
% \item[\texttt{Q} sequence:] for the delimiters
% \end{description}
% \begin{function}{
%   \__bnvs_rslv_prepare:nc,
% }
% \begin{syntax}
% \KWNlatex*{\__bnvs_rslv_prepare:nc} \KWNlatex{{|\KWNmeta{user queries}|}} \KWNlatex{{|\KWNmeta{var}|}}
% \end{syntax}
% Prepare the \KWNmeta{definitions} into \KWNmeta{var}.
% Expand and convert the \KWNmeta{definitions}.
% Replace any literally material \KWNmeta{...} enclosed between standard delimiters,
% by one of template \KWNlatex{\BNVS_crl:n{|\KWNmeta{...}|}},
% \KWNlatex{\sqr:n{|\KWNmeta{...}|}} or
% \KWNlatex{\rnd:n{|\KWNmeta{...}|}}.
% Replace assignment operators \KWNlatex{|\KWNmeta{[=?!]}|>} with commands
% \KWNlatex{\BNVS_assign:n{|\KWNmeta{[=?!]}|}}.
% On output, \KWNResolveIO{Prepare}{Output}{consists of}.
% \end{function}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\cs_new:Npn \BNVS_scan_close:n #1 {
  \BNVS_scan_A_to_Q:
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
\BNVS_coverage:n{close/#1}
%</!final>
% \end{BNVS.gobble}
%    \begin{macrocode}
  \__bnvs_seq_pop_left:ccTF Q A {
    \__bnvs_tl_if_eq:cnTF A { #1 } {
      \__bnvs_tl_put_right:cn Q { > > > }
    } {
      \BNVS_error:n { Too~many~`#1',~ignored. }
