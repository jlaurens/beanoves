% The main functions used for resolution are
% \begin{itemize}[label=\raisebox{-0.2ex}{\footnotesize\emoji{footprints}}]
% \item \KWNlatex{\__bnvs_resolve_query:nc},
% called first, the input is a raw query, which is not a clist object,
% on return the answer is^^A
% \KWNResolveIO*{Static}{Output}
% The result may be used as a single integer value as well as a \pkg{beamer}
% list of ranges. Depending on the context,
% the functions will be defined appropriately.
% \item \KWNlatex{\__bnvs_resolve_prepare:nc},
% called first by \KWNlatex{\__bnvs_resolve_query:nc},
% on return the prepared material consists of
% \KWNResolveIO*{Prepare}{Output}
% \item \KWNlatex{\__bnvs_resolve_subqueries:c},
% after resolution of subqueries the material consists of
% \KWNResolveIO*{Subqueries}{Output}
% \item \KWNlatex{\__bnvs_resolve_check:c}
% after resolution the material consists of
% \KWNResolveIO*{Check}{Output}
% \item \KWNlatex{\__bnvs_resolve_rhs:c}
% after resolution of assignments the material consists of
% \KWNResolveIO*{RHS}{Output}
% \item \KWNlatex{\__bnvs_resolve_assign:nc}
% after resolution of assignments the material consists of
% \KWNResolveIO*{Assign}{Output}
% \item \KWNlatex{\__bnvs_assign:Nwnnc}
% \end{itemize}
% These functions define the function in the input and run the input.
%
% The top level queries are a comma separated list of individual queries
% as augmented range specifications.
% Each individual query is temporarily stored in its own variable, then commands are inserted
% as markup. This variable is then executed to feed the top level resolution variable.
%
% The augmentations in individual queries can take different forms.
% At the top level we have only \KWNlatex{?(|\KWNmeta{queries}|)} or \KWNlatex{!:(|\KWNmeta{queries}|)} and inside we may have
% \begin{itemize}
% \item embedded \KWNlatex{?(|\KWNmeta{queries}|)} or \KWNlatex{!:(|\KWNmeta{queries}|)},
% \item colon delimited ranges,
% \item various assignments (standard, with increment and as provider),
% \item references with possible square brackets specification,
% \item pre and post increment.
% \end{itemize}
% ^^A
% The right hand side expression in assignments may contain commas.
% In that case there can be a conflict with top level commas.
% To avoid such ambiguity, one can put rounded brackets around the critical part. 
% ^^A
% \begin{variable}{\c__bnvs_bIKSRa_regex}
% Used by \KWNlatex{\__bnvs_resolve_prepare:nc}.
% \begin{description}
% \item[\KWNmeta{b}:] an optional collection of \KWNlatex{++} prefixes,
% \item[\KWNmeta{I}:] an optional \KWNmeta{id}
% \item[\KWNmeta{K}:] followed by a ``\KWNlatex{!}'', or 
% \item[\KWNmeta{S}:] an optional ``short name'',
% \item[\KWNmeta{R}:] a dotted path, including litteral optionally signed integer,
% \item[\KWNmeta{a}:] an optional collection of \KWNlatex{++} suffixes.
% \end{description}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\regex_const:Nn \c__bnvs_bIKSRa_regex {
  ( (?: \+\+ )* )
  (?: ( \ur{c__bnvs_S_regex} )? (!) )?
  ( \ur{c__bnvs_S_regex} )
  ( (?: \. \ur{c__bnvs_R_regex} )* )
  ( (?: \+\+)* )
  \s*
}
%    \end{macrocode}
