% \assert_equal_tl:vnn Z Z 2
% \assert_equal_tl:vnn L L 3
% \end{BNVS.test}
% \end{BNVS.macrocode}
% \begin{BNVS.macrocode}
%    \begin{macrocode}
\cs_new:Npn \BNVS_to_AZL:nnn #1 #2 #3 {
  \__bnvs_tl_set:cn A { #1 }
  \__bnvs_tl_set:cn Z { #2 }
  \tl_if_empty:nF { #2 } {
    \regex_replace_case_all:nN {
      { \c { BNVS_colon: } } { :  }
      { \c { BNVS_two_colons: } } { :: }
    } \l__bnvs_Z_tl
    \regex_replace_case_once:nN {
      {    ( [^:] +) (?: ::+ ( [^:]* ) ( .* ) )* }
      { \cB \{ \1 \cE \} \cB \{ \2 \cE \} \cB \{ \3 \cE \} }
      { :+ ( [^:] *) (?: :   ( [^:]* ) ( .* ) )*  }
      { \cB \{ \2 \cE \} \cB \{ \1 \cE \} \cB \{ \3 \cE \} }
%    \end{macrocode}
% \begin{BNVS.gobble}
%<*!final>
      { .* \Z }
      { \cB \{ 123 \cE \} \cB \{ 456 \cE \} \cB \{ 789 \cE \} }
%</!final>
% \end{BNVS.gobble}
%    \begin{macrocode}
    } \l__bnvs_Z_tl
    \exp_last_unbraced:NV \BNVS_to_ZL:nnnn \l__bnvs_Z_tl { #3 }
  }
}
%    \end{macrocode}
